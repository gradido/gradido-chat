// The contact list: the narrow window an instant messenger always had.
// It also holds the first page, where server and token are entered.

import { ScrollView } from "std-widgets.slint";
import { Theme, Tr, Icons } from "theme.slint";
import { Avatar, UnreadDot, IconButton, PillButton, Field, Check } from "widgets.slint";

export struct BuddyRow {
    key: string,
    // 0 section heading, 1 member, 2 group
    kind: int,
    title: string,
    line2: string,
    line3: string,
    letters: string,
    color: color,
    avatar: image,
    has-avatar: bool,
    unread: bool,
    favorite: bool,
    muted: bool,
}

component SectionRow inherits Rectangle {
    in property <string> text;
    in property <bool> with-plus;
    in property <string> plus-tip;
    callback plus;
    height: 28px;
    background: Theme.surface-muted;
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 6px;
        Text {
            text: root.text;
            color: Theme.text-muted;
            font-size: Theme.tiny;
            font-weight: 600;
            letter-spacing: 0.6px;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }
        if with-plus: VerticalLayout {
            alignment: center;
            IconButton {
                icon: Icons.plus;
                size: 22px;
                tip: plus-tip;
                clicked => { root.plus(); }
            }
        }
    }
}

component BuddyLine inherits Rectangle {
    in property <BuddyRow> item;
    callback opened;
    callback heart;
    height: 50px;
    background: touch.has-hover ? Theme.menu-hover : transparent;
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.opened(); }
    }
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 8px;
        spacing: 9px;
        VerticalLayout {
            alignment: center;
            Avatar {
                size: 36px;
                letters: item.letters;
                fill: item.color;
                picture: item.avatar;
                has-picture: item.has-avatar;
                group: item.kind == 2;
            }
        }
        VerticalLayout {
            alignment: center;
            spacing: 1px;
            horizontal-stretch: 1;
            Text {
                text: item.title;
                color: Theme.text;
                font-size: Theme.font;
                font-weight: item.unread ? 700 : 600;
                overflow: elide;
            }
            Text {
                text: item.line2 != "" && item.line3 != "" ? item.line2 + " · " + item.line3 : item.line2 + item.line3;
                color: Theme.text-muted;
                font-size: Theme.tiny;
                overflow: elide;
            }
        }
        if item.muted: VerticalLayout {
            alignment: center;
            Image {
                source: Icons.bell-off;
                colorize: Theme.text-muted;
                width: 14px;
                height: 14px;
            }
        }
        if item.unread: VerticalLayout {
            alignment: center;
            UnreadDot { }
        }
        if item.kind == 1: VerticalLayout {
            alignment: center;
            IconButton {
                icon: item.favorite ? Icons.heart : Icons.heart-outline;
                tint: item.favorite ? Theme.heart : Theme.text-muted;
                size: 24px;
                clicked => { root.heart(); }
            }
        }
    }
    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Theme.border;
    }
}

export component BuddyWindow inherits Window {
    title: Tr.t("app.title");
    icon: Icons.app;
    preferred-width: 300px;
    preferred-height: 640px;
    min-width: 240px;
    min-height: 360px;
    background: Theme.surface;
    default-font-family: "Open Sans";
    default-font-size: Theme.font;

    // 0 setup, 1 contacts
    in property <int> page;

    // --- setup ---
    in-out property <string> server;
    in-out property <string> token;
    in-out property <bool> keep-token: true;
    in property <bool> keyring-available: true;
    in property <bool> connecting;
    in property <string> setup-error;
    callback connect();

    // --- contacts ---
    in property <[BuddyRow]> rows;
    in property <string> me-name;
    in property <string> me-letters;
    in property <color> me-color;
    in property <image> me-avatar;
    in property <bool> me-has-avatar;
    in property <string> status;
    in property <bool> offline;
    in-out property <string> filter;
    in-out property <bool> sound;
    in-out property <bool> notifications;
    callback filter-edited(text: string);
    callback open(key: string);
    callback heart(key: string);
    callback new-group();
    callback sound-toggled(on: bool);
    callback notifications-toggled(on: bool);
    callback sign-out();

    // --- settings, over either page ---
    in-out property <bool> settings-open;
    // 0 system, 1 light, 2 dark
    in-out property <int> scheme;
    in-out property <bool> hardware;
    in-out property <bool> stay;
    in property <bool> has-tray;
    in property <string> version;
    callback scheme-chosen(scheme: int);
    callback hardware-toggled(on: bool);
    callback stay-toggled(on: bool);

    if settings-open: VerticalLayout {
        Rectangle {
            height: 56px;
            HorizontalLayout {
                padding-left: 14px;
                padding-right: 6px;
                Text {
                    text: Tr.t("app.settings.title");
                    color: Theme.text;
                    font-size: 16px;
                    font-weight: 700;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                VerticalLayout {
                    alignment: center;
                    IconButton {
                        icon: Icons.close;
                        tip: Tr.t("app.settings.close");
                        clicked => { root.settings-open = false; }
                    }
                }
            }
        }
        Rectangle {
            height: 1px;
            background: Theme.border;
        }
        ScrollView {
            vertical-stretch: 1;
            VerticalLayout {
                alignment: start;
                padding: 14px;
                spacing: 10px;
                Text {
                    text: Tr.t("app.settings.appearance");
                    color: Theme.text;
                    font-size: Theme.small;
                    font-weight: 600;
                }
                HorizontalLayout {
                    alignment: start;
                    spacing: 6px;
                    for name[index] in [Tr.t("app.settings.system"), Tr.t("app.settings.light"), Tr.t("app.settings.dark")]: PillButton {
                        text: name;
                        primary: root.scheme == index;
                        clicked => {
                            root.scheme = index;
                            root.scheme-chosen(index);
                        }
                    }
                }
                Rectangle { height: 6px; }
                Text {
                    text: Tr.t("app.settings.messages");
                    color: Theme.text;
                    font-size: Theme.small;
                    font-weight: 600;
                }
                Check {
                    text: Tr.t("app.menu.sound");
                    checked <=> root.sound;
                    toggled(on) => { root.sound-toggled(on); }
                }
                Check {
                    text: Tr.t("app.menu.notify");
                    checked <=> root.notifications;
                    toggled(on) => { root.notifications-toggled(on); }
                }
                Rectangle { height: 6px; }
                Text {
                    text: Tr.t("app.settings.program");
                    color: Theme.text;
                    font-size: Theme.small;
                    font-weight: 600;
                }
                if has-tray: Check {
                    text: Tr.t("app.menu.tray");
                    checked <=> root.stay;
                    toggled(on) => { root.stay-toggled(on); }
                }
                Check {
                    text: Tr.t("app.settings.hardware");
                    checked <=> root.hardware;
                    toggled(on) => { root.hardware-toggled(on); }
                }
                Text {
                    text: Tr.t("app.settings.hardwareHint");
                    color: Theme.text-muted;
                    font-size: Theme.tiny;
                    wrap: word-wrap;
                }
                Rectangle { height: 6px; }
                Text {
                    text: Tr.t("app.title") + " " + root.version;
                    color: Theme.text-muted;
                    font-size: Theme.tiny;
                }
            }
        }
    }

    if page == 0 && !settings-open: VerticalLayout {
        padding: 20px;
        spacing: 10px;
        alignment: start;
        HorizontalLayout {
            alignment: end;
            IconButton {
                icon: Icons.cog;
                size: 26px;
                tip: Tr.t("app.menu.settings");
                clicked => { root.settings-open = true; }
            }
        }
        HorizontalLayout {
            alignment: center;
            Image {
                source: Icons.app;
                width: 48px;
                height: 48px;
            }
        }
        Text {
            text: Tr.t("app.title");
            font-size: 20px;
            font-weight: 700;
            color: Theme.text;
            horizontal-alignment: center;
        }
        Text {
            text: Tr.t("app.setup.intro");
            color: Theme.text-muted;
            wrap: word-wrap;
            horizontal-alignment: center;
        }
        Rectangle { height: 6px; }
        Text {
            text: Tr.t("app.setup.server");
            color: Theme.text;
            font-size: Theme.small;
            font-weight: 600;
        }
        Field {
            text <=> root.server;
            placeholder: Tr.t("app.setup.serverPlaceholder");
            accepted => { root.connect(); }
        }
        Text {
            text: Tr.t("app.setup.token");
            color: Theme.text;
            font-size: Theme.small;
            font-weight: 600;
        }
        Field {
            text <=> root.token;
            placeholder: Tr.t("app.setup.tokenPlaceholder");
            password: true;
            accepted => { root.connect(); }
        }
        Text {
            text: Tr.t("app.setup.tokenHint");
            color: Theme.text-muted;
            font-size: Theme.tiny;
            wrap: word-wrap;
        }
        if keyring-available: Check {
            text: Tr.t("app.setup.keep");
            checked <=> root.keep-token;
        }
        if !keyring-available: Text {
            text: Tr.t("app.setup.noKeyring");
            color: Theme.text-muted;
            font-size: Theme.tiny;
            wrap: word-wrap;
        }
        if setup-error != "": Text {
            text: setup-error;
            color: Theme.danger;
            font-size: Theme.small;
            wrap: word-wrap;
        }
        HorizontalLayout {
            alignment: center;
            padding-top: 6px;
            PillButton {
                text: connecting ? Tr.t("app.setup.connecting") : Tr.t("app.setup.connect");
                enabled: !connecting && root.server != "" && root.token != "";
                clicked => { root.connect(); }
            }
        }
    }

    if page == 1 && !settings-open: VerticalLayout {
        // Who is signed in.
        Rectangle {
            height: 56px;
            background: Theme.surface;
            HorizontalLayout {
                padding-left: 10px;
                padding-right: 6px;
                spacing: 9px;
                VerticalLayout {
                    alignment: center;
                    Avatar {
                        size: 36px;
                        letters: me-letters;
                        fill: me-color;
                        picture: me-avatar;
                        has-picture: me-has-avatar;
                    }
                }
                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 1;
                    Text {
                        text: me-name;
                        color: Theme.text;
                        font-weight: 700;
                        overflow: elide;
                    }
                    Text {
                        text: status;
                        color: offline ? Theme.danger : Theme.text-muted;
                        font-size: Theme.tiny;
                        overflow: elide;
                    }
                }
                VerticalLayout {
                    alignment: center;
                    IconButton {
                        icon: Icons.logout;
                        tip: Tr.t("app.menu.signOut");
                        clicked => { root.sign-out(); }
                    }
                }
            }
        }
        HorizontalLayout {
            padding-left: 8px;
            padding-right: 8px;
            padding-bottom: 8px;
            Field {
                pill: true;
                height: 30px;
                text <=> root.filter;
                placeholder: Tr.t("contacts.search");
                edited(text) => { root.filter-edited(text); }
                escaped => {
                    root.filter = "";
                    root.filter-edited("");
                }
            }
        }
        Rectangle {
            height: 1px;
            background: Theme.border;
        }
        ScrollView {
            vertical-stretch: 1;
            VerticalLayout {
                alignment: start;
                for row in rows: VerticalLayout {
                    if row.kind == 0: SectionRow {
                        text: row.title;
                        with-plus: row.key == "groups";
                        plus-tip: Tr.t("chatGroup.new");
                        plus => { root.new-group(); }
                    }
                    if row.kind != 0: BuddyLine {
                        item: row;
                        opened => { root.open(row.key); }
                        heart => { root.heart(row.key); }
                    }
                }
            }
        }
        Rectangle {
            height: 1px;
            background: Theme.border;
        }
        // What a messenger does on a new message.
        Rectangle {
            height: 36px;
            background: Theme.surface-muted;
            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                spacing: 4px;
                VerticalLayout {
                    alignment: center;
                    IconButton {
                        icon: root.sound ? Icons.sound : Icons.sound-off;
                        active: root.sound;
                        size: 26px;
                        tip: Tr.t("app.menu.sound");
                        clicked => {
                            root.sound = !root.sound;
                            root.sound-toggled(root.sound);
                        }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    IconButton {
                        icon: root.notifications ? Icons.bell : Icons.bell-off;
                        active: root.notifications;
                        size: 26px;
                        tip: Tr.t("app.menu.notify");
                        clicked => {
                            root.notifications = !root.notifications;
                            root.notifications-toggled(root.notifications);
                        }
                    }
                }
                Rectangle {
                    horizontal-stretch: 1;
                }
                VerticalLayout {
                    alignment: center;
                    IconButton {
                        icon: Icons.cog;
                        size: 26px;
                        tip: Tr.t("app.menu.settings");
                        clicked => { root.settings-open = true; }
                    }
                }
            }
        }
    }
}
